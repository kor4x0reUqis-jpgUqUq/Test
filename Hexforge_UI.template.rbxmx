end)()
local Schema=(function()
local M={}
M.classes={CanvasGroup=true,Frame=true,TextLabel=true,TextButton=true,ImageLabel=true,ImageButton=true,ScrollingFrame=true,UIListLayout=true,UIGridLayout=true,UIPadding=true,UICorner=true,UIStroke=true,UIGradient=true,UIAspectRatioConstraint=true,UIScale=true,UISizeConstraint=true}
M.props={TileSize='u2',GroupTransparency='num',Active='bool',Size='u2',Position='u2',AnchorPoint='v2',BackgroundColor3='color',BackgroundTransparency='num',BorderSizePixel='num',Visible='bool',ClipsDescendants='bool',ZIndex='num',LayoutOrder='num',Rotation='num',Text='str',TextSize='num',TextColor3='color',TextTransparency='num',TextWrapped='bool',RichText='bool',AutoButtonColor='bool',TextStrokeTransparency='num',TextStrokeColor3='color',ImageColor3='color',ImageTransparency='num',ImageRectOffset='v2',ImageRectSize='v2',SliceCenter='rect',SliceScale='num',CanvasSize='u2',ScrollBarThickness='num',ScrollBarImageColor3='color',CornerRadius='u1',Thickness='num',Color='color',Transparency='num',Padding='u1',PaddingTop='u1',PaddingBottom='u1',PaddingLeft='u1',PaddingRight='u1',CellSize='u2',CellPadding='u2',FillDirectionMaxCells='num',AspectRatio='num',Scale='num',MinSize='v2',MaxSize='v2',Offset='v2'}
M.enums={Font={Gotham=true,GothamBold=true,GothamBlack=true,SourceSans=true,SourceSansBold=true},TextXAlignment={Left=true,Center=true,Right=true},TextYAlignment={Top=true,Center=true,Bottom=true},ScaleType={Stretch=true,Fit=true,Crop=true,Slice=true,Tile=true},AutomaticSize={None=true,X=true,Y=true,XY=true},AutomaticCanvasSize={None=true,X=true,Y=true,XY=true},FillDirection={Horizontal=true,Vertical=true},HorizontalAlignment={Left=true,Center=true,Right=true},VerticalAlignment={Top=true,Center=true,Bottom=true},SortOrder={LayoutOrder=true,Name=true},ApplyStrokeMode={Border=true,Contextual=true},LineJoinMode={Round=true,Bevel=true,Miter=true},ScrollingDirection={X=true,Y=true,XY=true}}
local function num(x)return type(x)=='number'and x==x and math.abs(x)&lt;=1000000 end
local function tuple(v,n)if type(v)~='table'or #v~=n then return false end;for _,x in ipairs(v)do if not num(x)then return false end end;return true end
local function label(x,max)return type(x)=='string'and #x&gt;0 and #x&lt;=max end
function M.validate(d,z)
 assert(type(d)=='table'and (d.format=='UIPack/1'or d.format=='UIPack/2'or d.format=='UIPack/3'),'Bu ZIP UIPack/1, UIPack/2 veya UIPack/3 formatında değil')
 assert(label(d.id,80)and d.id:match('^[%w_%-]+$'),'Paket kimliği yanlış');assert(label(d.title,120),'Paket başlığı eksik')
 assert(type(d.assets)=='table'and type(d.tree)=='table','Görsel/ağaç bilgisi eksik')
 local ids={}
 for _,a in ipairs(d.assets)do
  assert(label(a.key,80)and a.key:match('^[%w_%-]+$')and not ids[a.key],'Görsel anahtarı yanlış');ids[a.key]=true
  assert(num(a.width)and num(a.height)and a.width%1==0 and a.height%1==0 and a.width&gt;=1 and a.height&gt;=1 and a.width&lt;=1024 and a.height&lt;=1024,'Görsel boyutu 1–1024 piksel olmalı')
  assert(label(a.rgba,200)and z.entries[a.rgba]and z.entries[a.rgba].size==a.width*a.height*4,'RGBA8 dosyası eksik/boyutu yanlış')
  assert(label(a.png,200)and z.entries[a.png],'PNG kaynağı eksik')
 end
 local count=0;local names={}
 local function visit(n,depth)
  assert(depth&lt;=64 and type(n)=='table'and M.classes[n.class],'İzin verilmeyen UI sınıfı veya derinlik')
  count+=1;assert(label(n.name,80)and n.name:match('^[%a_][%w_]*$')and not names[n.name],'Benzersiz UI adı gerekli');names[n.name]=n
  for key,v in pairs(n.props or{})do
   local t=M.props[key];local e=M.enums[key]
   if e then assert(type(v)=='string'and e[v],'Enum değeri yanlış: '..key)
   elseif t=='num'then assert(num(v),'Sayı yanlış: '..key)
   elseif t=='bool'then assert(type(v)=='boolean','Boolean yanlış')
   elseif t=='str'then assert(type(v)=='string'and #v&lt;=16000,'Metin çok uzun')
   elseif t=='color'then assert(tuple(v,3),'Renk yanlış');for _,c in ipairs(v)do assert(c&gt;=0 and c&lt;=255,'RGB aralığı yanlış')end
   elseif t=='u2'or t=='rect'then assert(tuple(v,4),'4 bileşen gerekli')
   elseif t=='u1'or t=='v2' then assert(tuple(v,2),'2 bileşen gerekli')
   else error('İzin verilmeyen özellik: '..tostring(key))end
  end
  if n.imageId then assert((n.class=='ImageLabel'or n.class=='ImageButton')and type(n.imageId)=='string'and n.imageId:match('^%d+$')and tonumber(n.imageId)&gt;0 and tonumber(n.imageId)&lt;=9007199254740991,'imageId yanlış');assert(not n.asset,'asset ve imageId birlikte kullanılamaz')end
  if n.gradient then
   local g=n.gradient;assert(n.class=='UIGradient'and type(g)=='table','gradient UIGradient gerektirir')
   for k in pairs(g)do assert(k=='colors'or k=='transparency'or k=='rotation','Bilinmeyen gradient alanı')end
   local function stops(list,width)
    assert(type(list)=='table'and #list&gt;=2,'Gradient en az 2 keypoint gerektirir');local previous=-1
    for _,v in ipairs(list)do assert(tuple(v,width)and v[1]&gt;=0 and v[1]&lt;=1 and v[1]&gt;previous,'Gradient zamanı yanlış');previous=v[1]
     for j=2,width do assert(v[j]&gt;=0 and v[j]&lt;=(width==4 and 255 or 1),'Gradient değer aralığı yanlış')end
    end
    assert(list[1][1]==0 and list[#list][1]==1,'Gradient 0/1 uçları gerekli')
   end
   if g.colors then stops(g.colors,4)end;if g.transparency then stops(g.transparency,2)end
   if g.rotation then assert(num(g.rotation),'Gradient rotation sayı olmalı')end
  end
  if n.asset then assert(ids[n.asset]and(n.class=='ImageLabel'or n.class=='ImageButton'),'Görsel bağlantısı yanlış')end
  if n.action then assert(n.class=='TextButton'or n.class=='ImageButton','Aksiyon yalnız butonda');assert(n.action=='close'or n.action=='demo','Desteklenmeyen aksiyon')end
  if n.motion then assert(n.motion=='hover'or n.motion=='float'or n.motion=='glow'or n.motion=='snow','Desteklenmeyen hareket');if n.motion=='hover'then assert(n.class=='TextButton'or n.class=='ImageButton','Hover buton gerektirir')elseif n.motion=='snow'then assert(n.class=='Frame','Snow Frame gerektirir')elseif n.motion=='float'then assert(n.class=='ImageLabel'or n.class=='Frame'or n.class=='TextLabel','Float görsel nesne gerektirir')else assert(n.class=='ImageLabel'or n.class=='ImageButton','Glow görsel gerektirir')end end
  for _,c in ipairs(n.children or{})do visit(c,depth+1)end
 end
 visit(d.tree,1);assert(d.tree.class=='Frame','Kök Frame olmalı')
 assert(tuple(d.designSize,2)and d.designSize[1]&gt;=200 and d.designSize[2]&gt;=200 and d.designSize[1]&lt;=4096 and d.designSize[2]&lt;=4096,'Tasarım boyutu yanlış')
 local b=d.behavior
 if b then
  assert(type(b)=='table','behavior tablo olmalı')
  for k,_ in pairs(b)do assert(({openAsset=true,startOpen=true,duration=true,blur=true,fovDelta=true,sliders=true,menus=true,defaultMenu=true,demoPurchases=true})[k],'Bilinmeyen behavior: '..tostring(k))end
  if b.startOpen~=nil then assert(type(b.startOpen)=='boolean','startOpen boolean')end
  for _,r in ipairs({{'duration',.08,2},{'blur',0,56},{'fovDelta',-20,20}})do if b[r[1]]~=nil then assert(num(b[r[1]])and b[r[1]]&gt;=r[2]and b[r[1]]&lt;=r[3],'Efekt aralığı yanlış: '..r[1])end end
  local function ref(name,kind)
   local n=names[name];assert(n,'Etkileşim düğümü yok: '..tostring(name))
   if kind=='button'then assert(n.class=='ImageButton'or n.class=='TextButton','Buton gerekli')elseif kind=='text'then assert(n.class=='TextLabel','Dinamik TextLabel gerekli')elseif kind=='image'then assert(n.class=='ImageLabel'or n.class=='ImageButton','Image gerekli')end
   return n
  end
  if b.openAsset then assert(ids[b.openAsset],'Açma görseli eksik')end
  local bound={};local function button(n)ref(n,'button');assert(not bound[n],'Butona iki etkileşim atanamaz');bound[n]=true end
  local attributes={}
  for _,v in ipairs(b.sliders or{})do
   local track=ref(v.track);assert(track.class=='Frame'or track.class=='ImageLabel','Slider track Frame/ImageLabel olmalı');button(v.thumb);if v.fill then ref(v.fill)end;if v.label then ref(v.label,'text')end
   assert(num(v.min)and num(v.max)and v.max&gt;v.min and num(v.value)and v.value&gt;=v.min and v.value&lt;=v.max and num(v.step)and v.step&gt;0,'Slider aralığı yanlış')
   assert(label(v.attribute,80)and v.attribute:match('^Value_[%w_]+$'),'Slider attribute Value_ ile başlamalı')
   assert(not attributes[v.attribute],'Slider attribute tekrarlı');attributes[v.attribute]=true
   if v.format then assert(v.format=='number'or v.format=='percent','Slider formatı yanlış')end
  end
  local pages={}
  for _,v in ipairs(b.menus or{})do button(v.button);local n=ref(v.panel);assert(n.class=='Frame'or n.class=='CanvasGroup','Menü paneli Frame/CanvasGroup olmalı');assert(not pages[v.panel],'Menü paneli tekrarlı');pages[v.panel]=true end
  if b.defaultMenu then assert(pages[b.defaultMenu],'defaultMenu bulunamadı')end
  local productIDs={}
  for _,v in ipairs(b.demoPurchases or{})do
   if v.initialOwned~=nil then assert(type(v.initialOwned)=='boolean','initialOwned boolean')end;button(v.button);assert(label(v.id,80)and v.id:match('^[%w_]+$'),'Demo ürün kimliği gerekli');assert(not productIDs[v.id],'Demo ürün id tekrarlı');productIDs[v.id]=true;if v.label then ref(v.label,'text')end
   if v.image then ref(v.image,'image');for _,key in ipairs({'buyAsset','ownedAsset','equippedAsset'})do assert(ids[v[key]],'Demo durum görseli eksik: '..key)end end
  end
 end
 local codeNames={}
 for _,c in ipairs(d.scripts or{})do
  assert(label(c.name,80)and c.name:match('^[%a_][%w_]*$')and not codeNames[c.name],'Kod adı yanlış/tekrarlı');codeNames[c.name]=c
  assert(c.kind=='LocalScript'or c.kind=='Script'or c.kind=='ModuleScript','Kod sınıfı yanlış')
  assert(c.target=='UI'or c.target=='Shared'or c.target=='Server'or c.target=='Client','Kod hedefi yanlış')
  assert((c.target~='Shared'or c.kind=='ModuleScript')and(c.target~='Client'or c.kind=='LocalScript')and(c.target~='UI'or c.kind~='Script')and(c.target~='Server'or c.kind~='LocalScript'),'Kod hedef/sınıf çifti yanlış')
  assert(label(c.path,240)and z.entries[c.path]and z.entries[c.path].size&gt;0,'Kod dosyası eksik')
  assert(c.name~='UI_Motion'and c.name~='Package_Start'and c.name~='AssetMap'and c.name~='VFX'and c.name~='Viewport','Ayrılmış kod adı')
 end
 if d.controller then assert(codeNames[d.controller]and codeNames[d.controller].kind=='ModuleScript'and codeNames[d.controller].target=='UI','Controller UI ModuleScript olmalı')end
 local fxNames={}
 for _,f in ipairs(d.vfx or{})do
  assert(label(f.name,80)and f.name:match('^[%a_][%w_]*$')and not fxNames[f.name],'VFX adı yanlış');fxNames[f.name]=true
  assert(ids[f.texture],'VFX texture anahtarı eksik')
  assert(num(f.rate)and f.rate&gt;=0 and f.rate&lt;=10000,'VFX rate yanlış')
  assert(tuple(f.lifetime,2)and f.lifetime[1]&gt;0 and f.lifetime[2]&gt;=f.lifetime[1]and f.lifetime[2]&lt;=30,'VFX lifetime yanlış')
  assert(tuple(f.speed,2)and f.speed[1]&gt;=0 and f.speed[2]&gt;=f.speed[1],'VFX speed yanlış')
  assert(tuple(f.size,2)and f.size[1]&gt;=0 and f.size[2]&gt;=0 and tuple(f.color,3),'VFX boyut/renk yanlış')
  for _,v in ipairs(f.color)do assert(v&gt;=0 and v&lt;=255,'VFX renk aralığı yanlış')end
 end
 return count
end
return M

