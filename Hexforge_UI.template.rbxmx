local Library=(function()
-- Durable local package library. Raw ZIPs, not filesystem paths or temporary IDs.
local M={};M.MAX_TOTAL_BYTES=128*1024*1024;M.CHUNK=48000
local function fold(s)return(s:gsub('İ','i'):gsub('I','ı'):gsub('Ç','ç'):gsub('Ğ','ğ'):gsub('Ö','ö'):gsub('Ş','ş'):gsub('Ü','ü')):lower()end
local KEY='UIPLibraryIndexV3';local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local lookup={};for i=1,64 do lookup[alphabet:byte(i)]=i-1 end
local function clone(t)if type(t)~='table'then return t end;local c={};for k,v in pairs(t)do c[k]=clone(v)end;return c end
local function encode(s)
 local out={};for i=1,#s,3 do local a,b,c=s:byte(i,i+2);local n=a*65536+(b or 0)*256+(c or 0)
  out[#out+1]=alphabet:sub(math.floor(n/262144)%64+1,math.floor(n/262144)%64+1)..alphabet:sub(math.floor(n/4096)%64+1,math.floor(n/4096)%64+1)..(b and alphabet:sub(math.floor(n/64)%64+1,math.floor(n/64)%64+1)or'=')..(c and alphabet:sub(n%64+1,n%64+1)or'=')
