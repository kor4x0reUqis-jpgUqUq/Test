end
local function decode(s)
 assert(#s%4==0,'Kütüphane base64 bozuk');local out={}
 for i=1,#s,4 do local aa,bb,cc,dd=s:byte(i,i+3);local a,b,c,d=lookup[aa],lookup[bb],lookup[cc],lookup[dd];assert(a and b and(c or cc==61)and(d or dd==61),'Kütüphane base64 karakteri bozuk')
  local n=a*262144+b*4096+(c or 0)*64+(d or 0);out[#out+1]=string.char(math.floor(n/65536)%256);if cc~=61 then out[#out+1]=string.char(math.floor(n/256)%256)end;if dd~=61 then out[#out+1]=string.char(n%256)end
 end;return table.concat(out)
end
function M.new(store)
 local L={}
 local function index()
  local v=store:get(KEY);if v==nil then return{version=3,revision=0,entries={}}end
  assert(type(v)=='table'and v.version==3 and type(v.entries)=='table'and type(v.revision)=='number','Kütüphane indeksi bozuk; otomatik üzerine yazılmadı')
  v=clone(v);local ids={}
  for _,e in ipairs(v.entries)do
   assert(type(e.id)=='string'and not ids[e.id]and type(e.name)=='string'and type(e.bytes)=='number'and e.bytes&gt;=0 and type(e.payload)=='string'and type(e.chunks)=='number'and e.chunks&gt;=1 and type(e.crc)=='number','Kütüphane kaydı bozuk');ids[e.id]=true
  end
  return v
 end
 local function collect(payload,chunks,entries)
  local readable,latest=pcall(index);if not readable then return end;entries=latest.entries
  for _,e in ipairs(entries)do if e.payload==payload then return end end
  for n=1,chunks do pcall(function()store:set(payload..'_'..n,nil)end)end
 end
 local function commit(before,after)
  assert(index().revision==before.revision,'Başka Studio oturumu kütüphaneyi değiştirdi; tekrar dene')
  after.revision=before.revision+1
  local ok,err=pcall(function()store:set(KEY,after);local check=index();assert(check.revision==after.revision and #check.entries==#after.entries,'Kütüphane yazısı doğrulanamadı');for i,e in ipairs(after.entries)do assert(check.entries[i].id==e.id and check.entries[i].payload==e.payload,'Kütüphane readback farklı')end end)
  if not ok then
   local readable,current=pcall(index);local ours=readable and current.revision==after.revision and #current.entries==#after.entries
   if ours then for i,e in ipairs(after.entries)do if current.entries[i].id~=e.id or current.entries[i].payload~=e.payload then ours=false;break end end end
   if ours then pcall(function()store:set(KEY,before)end)end
   error('Kaydetme başarısız; belirsiz/başka oturum indeksi ezilmedi: '..tostring(err),0)
  end
 end
 function L:list(query)
  local rows=index().entries;query=fold(query or'');local out={}
  for _,e in ipairs(rows)do if query==''or string.find(fold(e.name),query,1,true)then out[#out+1]=e end end
  table.sort(out,function(a,b)return a.updated&gt;b.updated or(a.updated==b.updated and a.name&lt;b.name)end);return out
 end
 function L:load(id)
  for _,e in ipairs(index().entries)do if e.id==id then
   local pieces={};for n=1,e.chunks do local s=store:get(e.payload..'_'..n);assert(type(s)=='string','Kayıt parçası eksik: '..n);pieces[n]=s end
   local raw=decode(table.concat(pieces));assert(#raw==e.bytes and Binary.crc(raw)==e.crc,'Kayıt boyut/CRC doğrulaması başarısız');return raw,clone(e)
  end end;error('Kütüphane kaydı bulunamadı',0)
 end
 function L:save(name,raw,meta,replace)
  assert(type(name)=='string','İsim gerekli');name=name:match('^%s*(.-)%s*$');assert(#name&gt;0 and #name&lt;=160 and not name:find('%c'),'İsim 1–160 UTF8 byte olmalı')
  assert(type(raw)=='string'and #raw&gt;0,'Kaydedilecek ZIP yok');local before=index();local old
  for _,e in ipairs(before.entries)do if fold(e.name)==fold(name)then old=e;assert(replace,'Bu isim kayıtlı; açıkça Üzerine Yaz seç');break end end
  local total=#raw;for _,e in ipairs(before.entries)do if not old or e.id~=old.id then total+=e.bytes end end
  assert(total&lt;=M.MAX_TOTAL_BYTES,'Yerel kütüphane güvenlik kotası aşıldı')
  local crc=Binary.crc(raw);local reused
  for _,e in ipairs(before.entries)do if e.bytes==#raw and e.crc==crc then local ok,data=pcall(self.load,self,e.id);if ok and data==raw then reused=e;break end end end
  local payload=reused and reused.payload or('UIPLibraryDataV3_'..store:uuid());local chunks=reused and reused.chunks or 0;local wrote=false
  local ok,result=xpcall(function()
   if not reused then
    local encoded=encode(raw);chunks=math.ceil(#encoded/M.CHUNK);wrote=true
    for n=1,chunks do store:set(payload..'_'..n,encoded:sub((n-1)*M.CHUNK+1,n*M.CHUNK));if task then task.wait()end end
    local verify={};for n=1,chunks do verify[n]=assert(store:get(payload..'_'..n),'Kayıt readback eksik')end
    local roundtrip=decode(table.concat(verify));assert(roundtrip==raw,'Kayıt readback byte eşleşmiyor')
   end
   local entry={id=old and old.id or store:uuid(),name=name,payload=payload,chunks=chunks,bytes=#raw,crc=crc,created=old and old.created or os.time(),updated=os.time(),title=meta.title,packageId=meta.packageId,assetCount=meta.assetCount or 0}
   local after=clone(before);local list={};for _,e in ipairs(after.entries)do if not old or e.id~=old.id then list[#list+1]=e end end;list[#list+1]=entry;after.entries=list;commit(before,after)
   if old and old.payload~=payload then collect(old.payload,old.chunks,after.entries)end
   return entry
  end,debug.traceback)
  if not ok then if wrote then collect(payload,chunks,before.entries)end;error(result,0)end
  return result
 end
 function L:delete(id)
  local before=index();local after=clone(before);after.entries={};local removed
  for _,e in ipairs(before.entries)do if e.id==id then removed=e else after.entries[#after.entries+1]=e end end
  assert(removed,'Silinecek kayıt bulunamadı');commit(before,after);collect(removed.payload,removed.chunks,after.entries);return removed
 end
 return L
end
return M

end)()
local Bridge=(function()
local M={ready=false}
local HS=game:GetService('HttpService');local BASE='http://127.0.0.1:38476';local token=''
local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
function M.base64(raw)
 local out={}
 for i=1,#raw,3 do
  local a,b,c=raw:byte(i,i+2);local n=a*65536+(b or 0)*256+(c or 0)
  local x=math.floor(n/262144)%64;local y=math.floor(n/4096)%64;local z=math.floor(n/64)%64;local w=n%64
  out[#out+1]=alphabet:sub(x+1,x+1)..alphabet:sub(y+1,y+1)..(b and alphabet:sub(z+1,z+1)or'=')..(c and alphabet:sub(w+1,w+1)or'=')
  if i%49152==1 and i&gt;1 then task.wait()end
 end
 return table.concat(out)
end
local function call(path,method,data,public)
 local headers={['Content-Type']='application/json',['X-Hexforge-Pair']=script:WaitForChild('PairToken').Value};if not public then headers.Authorization='Bearer '..token end
 local request={Url=BASE..path,Method=method,Headers=headers};if data then request.Body=HS:JSONEncode(data)end
 local ok,response=pcall(HS.RequestAsync,HS,request)
 if not ok then M.ready=false;token='';error('Yerel köprüye ulaşılamadı. Kopru_Baslat.cmd açık olmalı; Studio HTTP/yerel ağ iznini kontrol et.',0)end
 local parsed,value=pcall(HS.JSONDecode,HS,response.Body)
 if not parsed or type(value)~='table'then error('Köprü beklenen JSON yanıtını vermedi.',0)end
 if not response.Success then
  if response.StatusCode==401 then M.ready=false;token=''end
  error(value.error or('Köprü HTTP '..response.StatusCode),0)
 end
 return value
end
local function handshake(path,data)
 M.ready=false;token=''
 local health=call('/health','GET',nil,true);assert(health.app=='HexforgeUI' and health.protocol==3,'Hexforge köprüsü 1.0 gerekli; eski köprüyü kapat.')
 local result=call(path,'POST',data,true);assert(type(result.token)=='string'and #result.token&gt;20,'Oturum açılamadı')
 token=result.token;M.ready=true;return result.message
end
function M.connect(key,remember)return handshake('/configure',{key=key,remember=remember==true})end
function M.resume()return handshake('/resume',{})end
function M.remember(value)return call('/remember','POST',{remember=value==true})end
function M.forget()local result=call('/forget','POST',{});M.ready=false;token='';return result end
function M.upload(pack,a,owner,cancel,log)
 assert(M.ready,'Önce API bağlantısını aç');assert(not cancel(),'İptal edildi')
 local raw=pack.zip:read(a.png)
 local transfer=call('/transfer','POST',{name=(pack.data.id..'_'..a.key):sub(1,50),creator={id=tostring(owner.id),kind=owner.group and'group'or'user'},length=#raw,crc=Binary.crc(raw)})
 assert(type(transfer.transfer)=='string','Transfer numarası eksik')
 local seq=0
 for pos=1,#raw,98304 do
  if cancel()then pcall(call,'/abort','POST',{transfer=transfer.transfer});error('Transfer iptal edildi',0)end
  local part=raw:sub(pos,pos+98303)
  local ack=call('/chunk','POST',{transfer=transfer.transfer,seq=seq,chunk=M.base64(part)})
  seq+=1;assert(ack.next==seq,'Transfer parçası doğrulanmadı')
 end
 local result=call('/complete','POST',{transfer=transfer.transfer})
 assert(type(result.job)=='string'and result.job:match('^[a-f0-9]+$'),'Köprü iş numarası eksik')
 local deadline=os.clock()+360
 while true do
  assert(not cancel(),'İptal: başlamış cloud işi köprüde tamamlanabilir; tekrar denemede hash cache kullanılır')
  local state=call('/jobs/'..result.job,'GET')
  if state.status=='done'then
   local id=tostring(state.assetId);assert(id:match('^%d+$')and tonumber(id)&gt;0,'Geçersiz gerçek assetId');return id
  elseif state.status=='error'then if state.code==401 then M.ready=false;token=''end;error(state.message or'Open Cloud upload başarısız',0)end
  assert(os.clock()&lt;deadline,'Upload bekleme süresi doldu; köprü açıkken aynı paketle tekrar dene')
  task.wait(.25)
 end
end
return M

end)()
local Motion=(function()
local M={}
function M.mount(gui,refs)
 local TS=game:GetService('TweenService');local UIS=game:GetService('UserInputService');local Run=game:GetService('RunService');local HS=game:GetService('HttpService')
 local runtime=gui:IsA('ScreenGui');local viewport=gui:WaitForChild('Viewport');local window=viewport:WaitForChild('Window');local scale=window:WaitForChild('ResponsiveScale');local backdrop=viewport:WaitForChild('Backdrop');local reopen=viewport:WaitForChild('Reopen');local toast=viewport:WaitForChild('Toast')
 local behavior=HS:JSONDecode(gui:GetAttribute('HFBehavior')or'{}');local duration=behavior.duration or .28
 if not refs then local map=gui:FindFirstChild('AssetMap');refs=map and HS:JSONDecode(map.Value)or{} end
 local connections={};local active={};local dead=false;local opened=false;local target=1;local epoch=0;local notifyEpoch=0
 local function bind(signal,fn)local c=signal:Connect(fn);table.insert(connections,c);return c end
 local function tween(o,t,p)
  if active[o]then active[o]:Cancel()end
  local tw=TS:Create(o,TweenInfo.new(t/(gui:GetAttribute('HFSpeed')or 1),Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p);active[o]=tw;tw:Play();return tw
 end
 local function find(n)return assert(window:FindFirstChild(n,true),'Etkileşim nesnesi bulunamadı: '..tostring(n))end
 local function image(o,key)local v=refs[key];if v then if typeof(v)=='Content'then o.ImageContent=v else o.Image=v end end end
 local camera,blur,proxy,fovConnection,baseFov,lastApplied,ownsFov
 local function clearCamera(restore)
  if proxy and active[proxy]then active[proxy]:Cancel();active[proxy]=nil end
  if fovConnection then fovConnection:Disconnect();fovConnection=nil end
  if restore and camera and ownsFov and math.abs(camera.FieldOfView-lastApplied)&lt;.05 then camera.FieldOfView=baseFov end
  if proxy then proxy:Destroy();proxy=nil end;if blur then blur:Destroy();blur=nil end;camera=nil;ownsFov=false
 end
 local function cameraOpen()
  if not runtime then return end
  clearCamera(true);camera=workspace.CurrentCamera;if not camera then return end
  baseFov=camera.FieldOfView;lastApplied=baseFov;ownsFov=true
  blur=Instance.new('BlurEffect');blur.Name='HF_Blur_'..gui.Name;blur.Size=0;blur.Parent=camera
  proxy=Instance.new('NumberValue');proxy.Value=baseFov
  fovConnection=proxy.Changed:Connect(function(value)
   if dead or not camera or not ownsFov then return end
   if workspace.CurrentCamera~=camera or math.abs(camera.FieldOfView-lastApplied)&gt;.05 then ownsFov=false;return end
   lastApplied=value;camera.FieldOfView=value
  end)
  tween(blur,duration,{Size=behavior.blur or 12});tween(proxy,duration,{Value=math.clamp(baseFov+(behavior.fovDelta or 5),1,120)})
 end
 local function cameraClose()
  if not camera then return end
  if blur then tween(blur,duration,{Size=0})end
  if ownsFov and math.abs(camera.FieldOfView-lastApplied)&lt;.05 then tween(proxy,duration,{Value=baseFov})else ownsFov=false end
  local old=proxy;task.delay(duration+.03,function()if not dead and not opened and proxy==old then clearCamera(true)end end)
 end
 local function fit()
  target=math.max(.05,math.min((viewport.AbsoluteSize.X-24)/gui:GetAttribute('DesignWidth'),(viewport.AbsoluteSize.Y-24)/gui:GetAttribute('DesignHeight'),1.12))*(gui:GetAttribute('HFZoom')or 1)
  if opened then tween(scale,.16,{Scale=target})end
 end
 toast.Size=UDim2.fromOffset(250,34);toast.AnchorPoint=Vector2.new(1,0);toast.Position=UDim2.new(1,-12,0,12);toast.TextSize=11;toast.BackgroundTransparency=.1;toast.Active=false
 local function notify(text)
  notifyEpoch+=1;local e=notifyEpoch;toast.Text=text;toast.Visible=true;toast.TextTransparency=1;tween(toast,.15,{TextTransparency=0})
  task.delay(1.7,function()if not dead and e==notifyEpoch then toast.Visible=false end end)
 end
 local function setOpen(value)
  epoch+=1;local e=epoch;opened=value;reopen.Visible=not value
  if value then window.Visible=true;scale.Scale=target*.94;window.GroupTransparency=1;tween(scale,duration,{Scale=target});tween(window,duration,{GroupTransparency=0});tween(backdrop,duration,{BackgroundTransparency=.42});cameraOpen()
  else tween(window,duration,{GroupTransparency=1});tween(scale,duration,{Scale=target*.94});tween(backdrop,duration,{BackgroundTransparency=1});cameraClose();task.delay(duration+.03,function()if not dead and epoch==e then window.Visible=false end end)end
 end
 local special={};for _,v in ipairs(behavior.sliders or{})do special[v.thumb]=true end
 for _,v in ipairs(behavior.menus or{})do special[v.button]=true end
 for _,v in ipairs(behavior.demoPurchases or{})do special[v.button]=true end
 for _,o in ipairs(window:GetDescendants())do
  local motion=o:GetAttribute('UIPMotion')
  if o:IsA('GuiButton')then
   if motion=='hover'then
    local s=Instance.new('UIScale');s.Name='HFHover';s.Parent=o
    bind(o.MouseEnter,function()tween(s,.16,{Scale=1.035})end);bind(o.MouseLeave,function()tween(s,.18,{Scale=1})end)
    bind(o.MouseButton1Down,function()tween(s,.08,{Scale=.97})end);bind(o.MouseButton1Up,function()tween(s,.16,{Scale=1.035})end)
   end
   bind(o.Activated,function()
    local action=o:GetAttribute('UIPAction')
    if action=='close'then setOpen(false)
    elseif action=='demo'and not special[o.Name]then
     local state=o:GetAttribute('HFDemoState')or 0;state=state==0 and 1 or(state==1 and 2 or 1);o:SetAttribute('HFDemoState',state)
     if o:IsA('TextButton')then o.Text=state==2 and'KUŞANILDI'or'SATIN ALINDI'end
     notify(state==2 and'DEMO • Kuşanıldı'or'DEMO • Yerel envantere eklendi')
    end
   end)
  end
  if motion=='float'then local tw=TS:Create(o,TweenInfo.new(2.1,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Position=o.Position+UDim2.fromOffset(0,-4)});active[o]=tw;tw:Play()end
  if motion=='glow'then local tw=TS:Create(o,TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{ImageTransparency=.55});active[o]=tw;tw:Play()end
  if motion=='snow'then
   local rng=Random.new(421);local flakes={};local elapsed=0
   for i=1,32 do local f=Instance.new('Frame');f.Name='HF_Particle_'..i;f.Size=UDim2.fromOffset(rng:NextInteger(2,4),rng:NextInteger(2,4));f.BorderSizePixel=0;f.BackgroundColor3=Color3.fromRGB(245,215,255);f.ZIndex=o.ZIndex;f.Parent=o;local c=Instance.new('UICorner');c.CornerRadius=UDim.new(1,0);c.Parent=f;flakes[i]={o=f,x=rng:NextNumber(),y=rng:NextNumber(),v=rng:NextNumber(.035,.075)}end
   bind(Run.Heartbeat,function(dt)if not opened or(not runtime and not gui.Visible)then return end;elapsed+=dt;for _,v in ipairs(flakes)do v.y=(v.y+dt*v.v)%1;v.o.BackgroundTransparency=math.clamp(.5+1-(((gui:GetAttribute('Value_VFX')or 100)/100)*(gui:GetAttribute('HFFxIntensity')or 1)),0,1);v.o.Position=UDim2.fromScale(v.x+math.sin(elapsed+v.x*6)*.01,v.y)end end)
  end
 end
 for _,v in ipairs(behavior.sliders or{})do
  local track=find(v.track);local thumb=find(v.thumb);local fill=v.fill and find(v.fill);local label=v.label and find(v.label);local dragging
  track.Active=true;thumb.AnchorPoint=Vector2.new(.5,.5)
  local function update(value)
   value=math.clamp(v.min+math.floor((value-v.min)/v.step+.5)*v.step,v.min,v.max);local u=(value-v.min)/(v.max-v.min)
   thumb.Position=UDim2.fromScale(u,.5);if fill then fill.Size=UDim2.fromScale(u,1)end
   if label then label.Text=v.format=='percent'and(string.format('%.0f%%',value))or tostring(value)end
   gui:SetAttribute(v.attribute,value)
  end
  local function position(x)if track.AbsoluteSize.X&gt;0 then update(v.min+math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)*(v.max-v.min))end end
  local function begin(input)if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=input;position(input.Position.X)end end
  bind(track.InputBegan,begin);bind(thumb.InputBegan,begin)
  bind(UIS.InputChanged,function(input)if dragging and(input==dragging or input.UserInputType==Enum.UserInputType.MouseMovement and dragging.UserInputType==Enum.UserInputType.MouseButton1)then position(input.Position.X)end end)
  bind(UIS.InputEnded,function(input)if input==dragging or input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=nil end end);update(v.value)
 end
 local menus=behavior.menus or{}
 local function menu(panel)
  for _,v in ipairs(menus)do local page=find(v.panel);local show=v.panel==panel;page.Visible=show
   if show and page:IsA('CanvasGroup')then page.GroupTransparency=1;tween(page,.2,{GroupTransparency=0})end
   find(v.button):SetAttribute('HFSelected',show)
  end;gui:SetAttribute('HFMenu',panel)
 end
 for _,v in ipairs(menus)do bind(find(v.button).Activated,function()menu(v.panel)end)end
 if #menus&gt;0 then menu(behavior.defaultMenu or menus[1].panel)end
 local states={};for _,v in ipairs(behavior.demoPurchases or{})do if v.initialOwned then states[v.id]=1 end end
 local function refreshPurchases()
  for _,v in ipairs(behavior.demoPurchases or{})do
   local state=states[v.id]or 0
   if v.label then find(v.label).Text=state==2 and'KUŞANILDI'or(state==1 and'SATIN ALINDI'or'SATIN AL')end
   if v.image then image(find(v.image),state==2 and v.equippedAsset or(state==1 and v.ownedAsset or v.buyAsset))end
   gui:SetAttribute('Owned_'..v.id,state&gt;0);gui:SetAttribute('Equipped_'..v.id,state==2)
  end
 end
 for _,v in ipairs(behavior.demoPurchases or{})do bind(find(v.button).Activated,function()
  if not states[v.id]then states[v.id]=1
  elseif states[v.id]==1 then for k,s in pairs(states)do if s==2 then states[k]=1 end end;states[v.id]=2
  else states[v.id]=1 end;refreshPurchases()
 end)end
 refreshPurchases()
 bind(reopen.Activated,function()setOpen(true)end)
 bind(viewport:GetPropertyChangedSignal('AbsoluteSize'),fit);bind(gui:GetAttributeChangedSignal('HFZoom'),fit)
 bind(gui.Destroying,function()dead=true;clearCamera(true);for _,c in ipairs(connections)do c:Disconnect()end;for _,tw in pairs(active)do tw:Cancel()end end)
 if runtime then gui.Enabled=true end;fit();setOpen(not runtime or behavior.startOpen~=false)
 return{open=setOpen,notify=notify}
end
return M

end)()
local CheckStyle=(function()
-- Adapted from the supplied Check-UI design specification; no screenshot cutouts.
local M={}
M.Palette={canvas={59,88,102},card={26,44,52},border={24,30,34},highlight={75,125,145},white={255,255,255},muted={225,235,245}}
M.Themes={close={{255,125,175},{255,20,40},{115,0,16}},magenta={{255,20,150},{225,0,25},{125,0,18}},cyan={{0,205,255},{0,130,245},{0,50,110}},silver={{255,255,255},{215,222,232},{90,100,112}},purple={{160,0,255},{96,0,200},{80,0,120}},lime={{180,255,25},{105,225,0},{15,120,15}},amber={{255,208,0},{255,140,0},{153,76,0}},red={{255,32,80},{208,0,32},{112,0,16}}}
M.Icons={settings='rbxassetid://75107759162473',info='rbxassetid://110199384922279',library='rbxassetid://88694661500877'}
function M.color(rgb)return Color3.fromRGB(rgb[1],rgb[2],rgb[3])end
function M.make(class,parent,props)
 local o=Instance.new(class);if o:IsA('GuiObject')then o.BorderSizePixel=0 end
 for k,v in pairs(props or{})do o[k]=v end
 if o:IsA('TextLabel')or o:IsA('TextButton')or o:IsA('TextBox')then
  o.Font=Enum.Font.GothamBlack;o.TextStrokeTransparency=1
  local st=Instance.new('UIStroke');st.Name='TextOutline';st.Color=Color3.fromRGB(0,0,0);st.Thickness=o.TextSize&gt;=24 and 2.8 or 1.5;st.Parent=o
 end
 o.Parent=parent;return o
end
function M.stroke(o,color,thick,trans)
 return M.make('UIStroke',o,{Name='Outline',Color=color or M.color(M.Palette.border),Thickness=thick or 3,Transparency=trans or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
function M.gradient(o,theme)
 local t=M.Themes[theme]or M.Themes.cyan
 return M.make('UIGradient',o,{Name='FaceGradient',Color=ColorSequence.new(M.color(t[1]),M.color(t[2])),Rotation=90})
end
function M.checker(o,button)
 local image=M.make('ImageLabel',o,{Name='Checkerboard',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Image='rbxassetid://385956923',ScaleType=Enum.ScaleType.Tile,TileSize=UDim2.fromOffset(button and 19 or 26,button and 19 or 26),ImageColor3=Color3.new(0,0,0),ZIndex=o.ZIndex+1})
 local seq=button and NumberSequence.new({NumberSequenceKeypoint.new(0,.91),NumberSequenceKeypoint.new(1,.62)})or NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.3,.82),NumberSequenceKeypoint.new(.7,.35),NumberSequenceKeypoint.new(1,.1)})
 M.make('UIGradient',image,{Name='DamierFade',Rotation=90,Transparency=seq});return image
end
function M.label(parent,value,pos,size,fontSize,color)
 return M.make('TextLabel',parent,{Text=value,TextSize=fontSize or 14,TextColor3=color or M.color(M.Palette.white),BackgroundTransparency=1,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,Position=pos,Size=size,ZIndex=parent.ZIndex+3})
end
function M.recess(o)
 o.BackgroundColor3=M.color(M.Palette.card);o.BackgroundTransparency=0
 M.stroke(o,Color3.fromRGB(8,17,22),2.8)
 local h=M.make('Frame',o,{Name='InnerHighlight',Size=UDim2.new(1,-4,1,-4),Position=UDim2.fromOffset(2,2),BackgroundTransparency=1,ZIndex=o.ZIndex+1});M.stroke(h,M.color(M.Palette.highlight),1.2,.4)
end
function M.button(parent,title,x,y,w,h,bind,callback,theme,icon)
 local t=M.Themes[theme or'cyan']or M.Themes.cyan
 local b=M.make('ImageButton',parent,{Name=title:gsub('[^%w]','_'),Position=UDim2.fromOffset(x+w/2,y+h/2),Size=UDim2.fromOffset(w,h),AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=Color3.new(1,1,1),AutoButtonColor=false,ClipsDescendants=true,ZIndex=parent.ZIndex+5})
 M.stroke(b,Color3.fromRGB(12,20,26),3);M.gradient(b,theme or'cyan');M.checker(b,true)
 M.make('Frame',b,{Name='BottomBevel',Position=UDim2.new(0,0,1,-4),Size=UDim2.new(1,0,0,4),BackgroundColor3=M.color(t[3]),ZIndex=b.ZIndex+2})
 for i,trans in ipairs({.25,.45,.8})do local f=M.make('Frame',b,{Name='InnerHighlight'..i,Size=UDim2.new(1,-i*2,1,-i*2),Position=UDim2.fromScale(.5,.5),AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,ZIndex=b.ZIndex+2});M.stroke(f,Color3.new(1,1,1),1,trans)end
 local label=M.label(b,title,UDim2.new(icon and .2 or 0,0,0,-1),UDim2.new(icon and .78 or 1,0,1,0),h&gt;=45 and 19 or 14);label.Name='Label';label.TextOutline.Thickness=h&gt;=40 and 3 or 2;label.TextXAlignment=Enum.TextXAlignment.Center;label.ZIndex=b.ZIndex+3
 if icon then M.make('ImageLabel',b,{Name='Icon',Image=icon,ScaleType=Enum.ScaleType.Fit,BackgroundTransparency=1,Position=UDim2.fromScale(.04,.16),Size=UDim2.fromScale(.14,.68),ZIndex=b.ZIndex+3})end
 local s=M.make('UIScale',b,{Name='ButtonScale',Scale=1});local tw
 local function animate(value,t)
  if tw then tw:Cancel()end;tw=game:GetService('TweenService'):Create(s,TweenInfo.new(t,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=value});tw:Play()
 end
 bind(b.MouseEnter,function()animate(1.06,.08)end);bind(b.MouseLeave,function()animate(1,.08)end);bind(b.MouseButton1Down,function()animate(.94,.05)end);bind(b.MouseButton1Up,function()animate(1.06,.12)end)
 bind(b.Destroying,function()if tw then tw:Cancel()end end)
 if callback then bind(b.Activated,callback)end
 return b
end
function M.header(parent,bind,onClose)
 local h=M.make('Frame',parent,{Name='Header',Size=UDim2.new(1,0,0,60),BackgroundColor3=Color3.new(1,1,1),ZIndex=2});M.gradient(h,'magenta');M.checker(h,false)
 M.make('Frame',h,{Name='DivDark',Position=UDim2.new(0,0,1,-6),Size=UDim2.new(1,0,0,3),BackgroundColor3=Color3.fromRGB(125,0,18),ZIndex=5})
 M.make('Frame',h,{Name='DivBlack',Position=UDim2.new(0,0,1,-3),Size=UDim2.new(1,0,0,3),BackgroundColor3=Color3.new(0,0,0),ZIndex=5})
 M.make('Frame',h,{Name='TopHighlight',Size=UDim2.new(1,0,0,2),BackgroundColor3=Color3.fromRGB(255,200,225),ZIndex=5})
 local title=M.label(h,'HEXFORGE UI',UDim2.fromOffset(18,0),UDim2.fromOffset(510,54),34);title.Name='Title';title.TextOutline.Thickness=3.2
 local x=M.button(h,'X',943,9,38,38,bind,onClose,'close');x.Name='CloseButton';x.Label.TextSize=29;x.Label.TextOutline.Thickness=3
 return h
end
function M.fit(hostWidth,hostHeight)
 local available=math.min((hostWidth-24)/1000,(hostHeight-24)/680)
 -- The skill's lower clamp is relaxed when it would overflow a narrow Studio viewport.
 return math.max(.05,math.min(available,math.clamp(math.min(hostWidth/1050,hostHeight/620),.52,1.18)))
end
return M

end)()
local Inspector=(function()
-- Pure data inspection, not native rendering or a device simulator.
local M={}
M.devices={{name='Masaüstü',width=1920,height=1080},{name='Tablet',width=1024,height=768},{name='Telefon',width=390,height=844}}
function M.deviceFit(index,landscape,w,h)
 local d=assert(M.devices[index],'Cihaz seçimi yanlış');local dw,dh=d.width,d.height
 if landscape then dw,dh=dh,dw end
 local factor=math.min(w/dw,h/dh)
 return math.max(1,math.floor(dw*factor)),math.max(1,math.floor(dh*factor)),dw,dh
end
function M.scan(data)
 local r={nodes={},warnings={},assets=#data.assets,scripts=#(data.scripts or{}),motions=0,controls=0,skippedLayouts=0,staticBounds=0}
 local gui={Frame=true,CanvasGroup=true,ImageLabel=true,ImageButton=true,TextLabel=true,TextButton=true,ScrollingFrame=true}
 local function visit(n,pw,ph,parentName,depth,skip)
  local p=n.props or{};local size=p.Size or{0,100,0,100};local position=p.Position or{0,0,0,0};local anchor=p.AnchorPoint or{0,0}
  local w=size[1]*pw+size[2];local h=size[3]*ph+size[4];local x=position[1]*pw+position[2]-anchor[1]*w;local y=position[3]*ph+position[4]-anchor[2]*h
  if depth==0 then w=data.designSize[1];h=data.designSize[2];x=0;y=0 end
  local row={measurable=gui[n.class]==true,name=n.name,class=n.class,depth=depth,asset=n.asset,action=n.action,motion=n.motion,width=w,height=h,x=x,y=y}
  table.insert(r.nodes,row);if n.motion then r.motions+=1 end
  if gui[n.class]and depth&gt;0 and not skip then
   r.staticBounds+=1
   if x&lt;-.5 or y&lt;-.5 or x+w&gt;pw+.5 or y+h&gt;ph+.5 then table.insert(r.warnings,n.name..' → '..parentName..' sınırı dışında; efekt/scroll amacıyla kasıtlı olabilir.')end
  end
  local layout=false
  for _,c in ipairs(n.children or{})do if c.class=='UIListLayout'or c.class=='UIGridLayout'then layout=true end end
  local auto=p.AutomaticSize and p.AutomaticSize~='None'
  if layout or auto then r.skippedLayouts+=1 end
  for _,c in ipairs(n.children or{})do visit(c,w,h,n.name,depth+1,skip or layout or auto or n.class=='ScrollingFrame')end
 end
 visit(data.tree,data.designSize[1],data.designSize[2],'Root',0,false)
 local b=data.behavior or{};r.controls=#(b.sliders or{})+#(b.menus or{})+#(b.demoPurchases or{})
 r.text=string.format('%s\n%d katman • %d PNG • %d kod • %d etkileşim\nTasarım: %d × %d\n\nSTATİK KONTROL (native test değil)\n%d geometri incelendi; %d layout/otomatik boyut alanı atlandı.\n',data.title,#r.nodes,r.assets,r.scripts,r.controls,data.designSize[1],data.designSize[2],r.staticBounds,r.skippedLayouts)
 if #r.warnings==0 then r.text..='Hesaplanabilen sınırlarda taşma uyarısı yok.\n'else r.text..=table.concat(r.warnings,'\n')..'\n'end
 r.text..='\nMetin taşması, font, döndürme, UIAspectRatioConstraint, native layout, asset moderasyonu ve input sonucu burada doğrulanmaz. Eksik/bozuk paket dosyaları yüklemede Schema ve CRC ile ayrıca reddedilir.'
 return r
end
return M

end)()
local RuntimeSource=[=[local Motion=(function()
local M={}
function M.mount(gui,refs)
 local TS=game:GetService('TweenService');local UIS=game:GetService('UserInputService');local Run=game:GetService('RunService');local HS=game:GetService('HttpService')
 local runtime=gui:IsA('ScreenGui');local viewport=gui:WaitForChild('Viewport');local window=viewport:WaitForChild('Window');local scale=window:WaitForChild('ResponsiveScale');local backdrop=viewport:WaitForChild('Backdrop');local reopen=viewport:WaitForChild('Reopen');local toast=viewport:WaitForChild('Toast')
 local behavior=HS:JSONDecode(gui:GetAttribute('HFBehavior')or'{}');local duration=behavior.duration or .28
 if not refs then local map=gui:FindFirstChild('AssetMap');refs=map and HS:JSONDecode(map.Value)or{} end
 local connections={};local active={};local dead=false;local opened=false;local target=1;local epoch=0;local notifyEpoch=0
 local function bind(signal,fn)local c=signal:Connect(fn);table.insert(connections,c);return c end
 local function tween(o,t,p)
  if active[o]then active[o]:Cancel()end
  local tw=TS:Create(o,TweenInfo.new(t/(gui:GetAttribute('HFSpeed')or 1),Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p);active[o]=tw;tw:Play();return tw
 end
 local function find(n)return assert(window:FindFirstChild(n,true),'Etkileşim nesnesi bulunamadı: '..tostring(n))end
 local function image(o,key)local v=refs[key];if v then if typeof(v)=='Content'then o.ImageContent=v else o.Image=v end end end
 local camera,blur,proxy,fovConnection,baseFov,lastApplied,ownsFov
 local function clearCamera(restore)
  if proxy and active[proxy]then active[proxy]:Cancel();active[proxy]=nil end
  if fovConnection then fovConnection:Disconnect();fovConnection=nil end
  if restore and camera and ownsFov and math.abs(camera.FieldOfView-lastApplied)&lt;.05 then camera.FieldOfView=baseFov end
  if proxy then proxy:Destroy();proxy=nil end;if blur then blur:Destroy();blur=nil end;camera=nil;ownsFov=false
 end
 local function cameraOpen()
  if not runtime then return end
  clearCamera(true);camera=workspace.CurrentCamera;if not camera then return end
  baseFov=camera.FieldOfView;lastApplied=baseFov;ownsFov=true
  blur=Instance.new('BlurEffect');blur.Name='HF_Blur_'..gui.Name;blur.Size=0;blur.Parent=camera
  proxy=Instance.new('NumberValue');proxy.Value=baseFov
  fovConnection=proxy.Changed:Connect(function(value)
   if dead or not camera or not ownsFov then return end
   if workspace.CurrentCamera~=camera or math.abs(camera.FieldOfView-lastApplied)&gt;.05 then ownsFov=false;return end
   lastApplied=value;camera.FieldOfView=value
  end)
  tween(blur,duration,{Size=behavior.blur or 12});tween(proxy,duration,{Value=math.clamp(baseFov+(behavior.fovDelta or 5),1,120)})
 end
 local function cameraClose()
  if not camera then return end
  if blur then tween(blur,duration,{Size=0})end
  if ownsFov and math.abs(camera.FieldOfView-lastApplied)&lt;.05 then tween(proxy,duration,{Value=baseFov})else ownsFov=false end
  local old=proxy;task.delay(duration+.03,function()if not dead and not opened and proxy==old then clearCamera(true)end end)
 end
 local function fit()
  target=math.max(.05,math.min((viewport.AbsoluteSize.X-24)/gui:GetAttribute('DesignWidth'),(viewport.AbsoluteSize.Y-24)/gui:GetAttribute('DesignHeight'),1.12))*(gui:GetAttribute('HFZoom')or 1)
  if opened then tween(scale,.16,{Scale=target})end
 end
 toast.Size=UDim2.fromOffset(250,34);toast.AnchorPoint=Vector2.new(1,0);toast.Position=UDim2.new(1,-12,0,12);toast.TextSize=11;toast.BackgroundTransparency=.1;toast.Active=false
 local function notify(text)
  notifyEpoch+=1;local e=notifyEpoch;toast.Text=text;toast.Visible=true;toast.TextTransparency=1;tween(toast,.15,{TextTransparency=0})
  task.delay(1.7,function()if not dead and e==notifyEpoch then toast.Visible=false end end)
 end
 local function setOpen(value)
  epoch+=1;local e=epoch;opened=value;reopen.Visible=not value
  if value then window.Visible=true;scale.Scale=target*.94;window.GroupTransparency=1;tween(scale,duration,{Scale=target});tween(window,duration,{GroupTransparency=0});tween(backdrop,duration,{BackgroundTransparency=.42});cameraOpen()
  else tween(window,duration,{GroupTransparency=1});tween(scale,duration,{Scale=target*.94});tween(backdrop,duration,{BackgroundTransparency=1});cameraClose();task.delay(duration+.03,function()if not dead and epoch==e then window.Visible=false end end)end
 end
 local special={};for _,v in ipairs(behavior.sliders or{})do special[v.thumb]=true end
 for _,v in ipairs(behavior.menus or{})do special[v.button]=true end
 for _,v in ipairs(behavior.demoPurchases or{})do special[v.button]=true end
 for _,o in ipairs(window:GetDescendants())do
  local motion=o:GetAttribute('UIPMotion')
  if o:IsA('GuiButton')then
   if motion=='hover'then
    local s=Instance.new('UIScale');s.Name='HFHover';s.Parent=o
    bind(o.MouseEnter,function()tween(s,.16,{Scale=1.035})end);bind(o.MouseLeave,function()tween(s,.18,{Scale=1})end)
    bind(o.MouseButton1Down,function()tween(s,.08,{Scale=.97})end);bind(o.MouseButton1Up,function()tween(s,.16,{Scale=1.035})end)
   end
   bind(o.Activated,function()
    local action=o:GetAttribute('UIPAction')
    if action=='close'then setOpen(false)
    elseif action=='demo'and not special[o.Name]then
     local state=o:GetAttribute('HFDemoState')or 0;state=state==0 and 1 or(state==1 and 2 or 1);o:SetAttribute('HFDemoState',state)
     if o:IsA('TextButton')then o.Text=state==2 and'KUŞANILDI'or'SATIN ALINDI'end
     notify(state==2 and'DEMO • Kuşanıldı'or'DEMO • Yerel envantere eklendi')
    end
   end)
  end
  if motion=='float'then local tw=TS:Create(o,TweenInfo.new(2.1,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Position=o.Position+UDim2.fromOffset(0,-4)});active[o]=tw;tw:Play()end
  if motion=='glow'then local tw=TS:Create(o,TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{ImageTransparency=.55});active[o]=tw;tw:Play()end
  if motion=='snow'then
   local rng=Random.new(421);local flakes={};local elapsed=0
   for i=1,32 do local f=Instance.new('Frame');f.Name='HF_Particle_'..i;f.Size=UDim2.fromOffset(rng:NextInteger(2,4),rng:NextInteger(2,4));f.BorderSizePixel=0;f.BackgroundColor3=Color3.fromRGB(245,215,255);f.ZIndex=o.ZIndex;f.Parent=o;local c=Instance.new('UICorner');c.CornerRadius=UDim.new(1,0);c.Parent=f;flakes[i]={o=f,x=rng:NextNumber(),y=rng:NextNumber(),v=rng:NextNumber(.035,.075)}end
   bind(Run.Heartbeat,function(dt)if not opened or(not runtime and not gui.Visible)then return end;elapsed+=dt;for _,v in ipairs(flakes)do v.y=(v.y+dt*v.v)%1;v.o.BackgroundTransparency=math.clamp(.5+1-(((gui:GetAttribute('Value_VFX')or 100)/100)*(gui:GetAttribute('HFFxIntensity')or 1)),0,1);v.o.Position=UDim2.fromScale(v.x+math.sin(elapsed+v.x*6)*.01,v.y)end end)
  end
 end
 for _,v in ipairs(behavior.sliders or{})do
  local track=find(v.track);local thumb=find(v.thumb);local fill=v.fill and find(v.fill);local label=v.label and find(v.label);local dragging
  track.Active=true;thumb.AnchorPoint=Vector2.new(.5,.5)
  local function update(value)
   value=math.clamp(v.min+math.floor((value-v.min)/v.step+.5)*v.step,v.min,v.max);local u=(value-v.min)/(v.max-v.min)
   thumb.Position=UDim2.fromScale(u,.5);if fill then fill.Size=UDim2.fromScale(u,1)end
   if label then label.Text=v.format=='percent'and(string.format('%.0f%%',value))or tostring(value)end
   gui:SetAttribute(v.attribute,value)
  end
  local function position(x)if track.AbsoluteSize.X&gt;0 then update(v.min+math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)*(v.max-v.min))end end
  local function begin(input)if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=input;position(input.Position.X)end end
  bind(track.InputBegan,begin);bind(thumb.InputBegan,begin)
  bind(UIS.InputChanged,function(input)if dragging and(input==dragging or input.UserInputType==Enum.UserInputType.MouseMovement and dragging.UserInputType==Enum.UserInputType.MouseButton1)then position(input.Position.X)end end)
  bind(UIS.InputEnded,function(input)if input==dragging or input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=nil end end);update(v.value)
 end
 local menus=behavior.menus or{}
 local function menu(panel)
  for _,v in ipairs(menus)do local page=find(v.panel);local show=v.panel==panel;page.Visible=show
   if show and page:IsA('CanvasGroup')then page.GroupTransparency=1;tween(page,.2,{GroupTransparency=0})end
   find(v.button):SetAttribute('HFSelected',show)
  end;gui:SetAttribute('HFMenu',panel)
 end
 for _,v in ipairs(menus)do bind(find(v.button).Activated,function()menu(v.panel)end)end
 if #menus&gt;0 then menu(behavior.defaultMenu or menus[1].panel)end
 local states={};for _,v in ipairs(behavior.demoPurchases or{})do if v.initialOwned then states[v.id]=1 end end
 local function refreshPurchases()
  for _,v in ipairs(behavior.demoPurchases or{})do
   local state=states[v.id]or 0
   if v.label then find(v.label).Text=state==2 and'KUŞANILDI'or(state==1 and'SATIN ALINDI'or'SATIN AL')end
   if v.image then image(find(v.image),state==2 and v.equippedAsset or(state==1 and v.ownedAsset or v.buyAsset))end
   gui:SetAttribute('Owned_'..v.id,state&gt;0);gui:SetAttribute('Equipped_'..v.id,state==2)
  end
 end
 for _,v in ipairs(behavior.demoPurchases or{})do bind(find(v.button).Activated,function()
  if not states[v.id]then states[v.id]=1
  elseif states[v.id]==1 then for k,s in pairs(states)do if s==2 then states[k]=1 end end;states[v.id]=2
  else states[v.id]=1 end;refreshPurchases()
 end)end
 refreshPurchases()
 bind(reopen.Activated,function()setOpen(true)end)
 bind(viewport:GetPropertyChangedSignal('AbsoluteSize'),fit);bind(gui:GetAttributeChangedSignal('HFZoom'),fit)
 bind(gui.Destroying,function()dead=true;clearCamera(true);for _,c in ipairs(connections)do c:Disconnect()end;for _,tw in pairs(active)do tw:Cancel()end end)
 if runtime then gui.Enabled=true end;fit();setOpen(not runtime or behavior.startOpen~=false)
 return{open=setOpen,notify=notify}
end
return M

end)()
Motion.mount(script.Parent)
