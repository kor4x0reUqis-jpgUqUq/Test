button(packagePage,'save_label',458,0,192,45,function()operation(function()assert(pack,'Paket yok');library:save(saveName.Text,pack.raw,{title=pack.data.title,packageId=pack.data.id,assetCount=#pack.data.assets},replace);log('İsimli kayıt kaydedildi. Orijinal ZIP artık gerekli değil.');if refreshLibrary then refreshLibrary()end end)end,'library')
local function owner()if uploadOwner.mode=='Grup'then return Engine.owner('Grup',uploadOwner.id)end;return Engine.owner(uploadOwner.mode)end
button(packagePage,'publish_label',0,389,210,49,function()operation(function()
 assert(pack,'Paket yok');assert(#pack.data.assets==0 or Bridge.ready,'Önce Ayarlar → API bağlantısı');assert(not Run:IsRunning(),'Kurulum için Play’i durdur');assert(#(pack.data.scripts or{})==0 or approved,'Paket kodunu önce inceleyip açıkça onayla')
 local package=pack;local target=owner();Engine.canInstall(package,replace);log('Kalıcı görseller yükleniyor → '..target.label,0)
 local ids=Engine.upload(package,target,plugin,{},log,function()return canceled or dead end,function(done,total,key)log(done..'/'..total..' • '..key,done/math.max(total,1))end)
 assert(not dead and not canceled and not Run:IsRunning(),'Commit öncesi iptal');local staged=Engine.stage(package,ids,target,approved)
 local ok,result=pcall(Engine.commit,staged,replace,package.data.id);if not ok then for _,r in ipairs(staged)do r.object:Destroy()end;error(result,0)end;lastInstall=result
 log('Kuruldu. Edit’te kapalı; Play’de kendi açma düğmesi var.',1)
end)end,'publish')
button(packagePage,'undo_label',230,389,195,49,function()operation(function()assert(lastInstall,'Geri alınacak kurulum yok');Engine.undo(lastInstall);lastInstall=nil;log('Son kurulum geri alındı.')end)end)
button(packagePage,'hide_label',445,389,205,49,function()operation(function()
 assert(not Run:IsRunning(),'Edit gizleme için önce Play’i durdur');local count=0;for _,gui in ipairs(game:GetService('StarterGui'):GetChildren())do if gui:IsA('ScreenGui')and gui:GetAttribute('UIPackage')and tostring(gui:GetAttribute('UIInstaller')or''):match('^UI Studio')then
  gui.Enabled=false;gui:SetAttribute('HFEditHidden',true)
  local boot=gui:FindFirstChild('HF_EditMigration');if not boot then boot=Instance.new('LocalScript');boot.Name='HF_EditMigration';boot.Source="script.Parent.Enabled=true";boot.Parent=gui end;count+=1
 end end;log(count..' eski UI edit modunda gizlendi; diğer GUI’lere dokunulmadı.')
end)end)
-- ZIP code is inert until the user reviews and explicitly approves this package.
local reviewPanel=make('Frame',shell,{Position=UDim2.fromOffset(270,142),Size=UDim2.fromOffset(665,454),BackgroundColor3=C.bg,Visible=false,ZIndex=90});round(reviewPanel)
local codeScroll=make('ScrollingFrame',reviewPanel,{Position=UDim2.fromOffset(12,12),Size=UDim2.fromOffset(641,365),BackgroundColor3=C.card,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.XY,ScrollBarThickness=5,ClipsDescendants=true,ZIndex=91});local code=input(codeScroll,'',0,0,620,0);code.AutomaticSize=Enum.AutomaticSize.XY;code.TextWrapped=false;code.MultiLine=true;code.TextEditable=false;code.TextXAlignment=Enum.TextXAlignment.Left;code.TextYAlignment=Enum.TextYAlignment.Top;code.TextSize=11;code.ZIndex=91
local reviewPack
button(settingsPage,'review_label',0,388,245,45,function()
 if not pack then log('Önce paket aç.');return end;reviewPack=pack;local out={'UYARI: Onaylanan kod Studio’da ve/veya oyunda çalışabilir. Güvenmediğin paketi onaylama.'}
 for _,c in ipairs(pack.data.scripts or{})do table.insert(out,'\n--- '..c.target..' / '..c.kind..' / '..c.name..' ---\n'..pack.zip:read(c.path))end;code.Text=table.concat(out,'\n');reviewPanel.Visible=true
end)
button(reviewPanel,'approve_label',12,390,305,45,function()if pack==reviewPack then approved=true;reviewPanel.Visible=false;log('Yalnız bu paketin kodları onaylandı.')else log('Paket değişti; yeniden incele.')end end).ZIndex=92
button(reviewPanel,'close_label',340,390,305,45,function()reviewPanel.Visible=false end).ZIndex=92
local search=input(libraryPage,'Kayıt ara…',0,0,650,38)
local list=make('ScrollingFrame',libraryPage,{Position=UDim2.fromOffset(0,52),Size=UDim2.fromOffset(650,392),BackgroundTransparency=1,ScrollBarThickness=4,ScrollBarImageColor3=C.accent,CanvasSize=UDim2.new()})
refreshLibrary=function()
 for _,o in ipairs(list:GetChildren())do o:Destroy()end;local rows=library:list(search.Text)
 for i,row in ipairs(rows)do
  local y=(i-1)*83;text(list,row.name..'\n'..row.title,UDim2.fromOffset(8,y+8),UDim2.fromOffset(310,55))
  button(list,'open_zip',335,y+12,145,43,function()operation(function()loadPackage(library:load(row.id));saveName.Text=row.name;selectPage('Package')end)end)
  local armed=false;local del=button(list,'delete_label',493,y+12,145,43,function()
   if not armed then armed=true;log('Yerel kaydı silmek için aynı Sil düğmesine tekrar bas. Cloud silinmez.');task.delay(3,function()armed=false end);return end
   operation(function()library:delete(row.id);refreshLibrary();log('Yalnız yerel kütüphane kaydı silindi.')end)
  end)
 end;list.CanvasSize=UDim2.fromOffset(0,#rows*83)
end
bind(search:GetPropertyChangedSignal('Text'),function()local ok,e=pcall(refreshLibrary);if not ok then log(e)end end)
text(settingsPage,'API ANAHTARI',UDim2.fromOffset(0,0),UDim2.fromOffset(260,28)).TextSize=22;text(settingsPage,'Windows DPAPI / isteğe bağlı kasa',UDim2.fromOffset(300,4),UDim2.fromOffset(350,20),C.muted).TextSize=12
local key=input(settingsPage,'',0,40,400,42);key.TextTransparency=1;key.TextOutline.Transparency=1
local bullets=text(settingsPage,'Anahtarı buraya yapıştır…',UDim2.fromOffset(14,40),UDim2.fromOffset(370,42),C.muted)
bind(bullets.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then key:CaptureFocus()end end)
bind(key:GetPropertyChangedSignal('Text'),function()bullets.Text=#key.Text==0 and'Anahtarı buraya yapıştır…'or string.rep('●',math.min(#key.Text,28))end)
local remember=plugin:GetSetting('HexforgeRemember')==true
local rememberButton=make('TextButton',settingsPage,{Position=UDim2.fromOffset(0,91),Size=UDim2.fromOffset(650,26),BackgroundTransparency=1,Text=(remember and'[✓] 'or'[ ] ')..'Bu Windows hesabında şifreli hatırla (DPAPI)',TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.Gotham,TextColor3=C.muted})
bind(rememberButton.Activated,function()if busy then log('İşlem sürerken kasa tercihini değiştirme.');return end;remember=not remember;if Bridge.ready then operation(function()Bridge.remember(remember);log(remember and'Anahtar DPAPI ile kaydedildi.'or'Kalıcı anahtar silindi; bu oturum açık.')end)end;plugin:SetSetting('HexforgeRemember',remember);rememberButton.Text=(remember and'[✓] 'or'[ ] ')..'Bu Windows hesabında şifreli hatırla (DPAPI)'end)
local function publishSkin()log('Yerel API oturumu hazır. Check-UI mevcut asset ID’lerini kullanır; plugin skin upload’ı gerekmez.',1)end
button(settingsPage,'connect_label',417,39,233,44,function()operation(function()local secret=key.Text;key.Text='';Bridge.connect(secret,remember);secret=nil;publishSkin()end)end)
button(settingsPage,'forget_label',0,124,280,42,function()operation(function()Bridge.forget();plugin:SetSetting('HexforgeRemember',false);remember=false;rememberButton.Text='[ ] Bu Windows hesabında şifreli hatırla (DPAPI)';key.Text='';log('Kaydedilmiş anahtar silindi. Asset cache silinmedi.')end)end)
local ownerLabel=text(settingsPage,'',UDim2.fromOffset(300,126),UDim2.fromOffset(350,40),C.accent)
local function updateOwnerLabel()local ok,value=pcall(owner);ownerLabel.Text=ok and value.label or'Hedef belirlenemedi'end
updateOwnerLabel()
local ownerPanel=make('ScrollingFrame',settingsPage,{Position=UDim2.fromOffset(0,220),Size=UDim2.fromOffset(650,200),BackgroundColor3=C.bg,ScrollBarThickness=4,Visible=false,ZIndex=70})
button(settingsPage,'owner_label',0,179,280,38,function()operation(function()
 for _,o in ipairs(ownerPanel:GetChildren())do o:Destroy()end
 local rows={{mode='Auto',label='Oyunun sahibi (otomatik)'},{mode='Hesabım',label='Studio hesabım'}}
 local ok,groups=pcall(function()return game:GetService('GroupService'):GetGroupsAsync(Studio:GetUserId())end)
 if ok then for _,g in ipairs(groups)do rows[#rows+1]={mode='Grup',id=g.Id,label=g.Name..' • '..g.Role}end end
 for i,row in ipairs(rows)do local b=make('TextButton',ownerPanel,{Position=UDim2.fromOffset(7,(i-1)*35),Size=UDim2.new(1,-21,0,32),Text=row.label,TextSize=12,Font=Enum.Font.Gotham,TextColor3=C.text,BackgroundColor3=C.card,ZIndex=71});bind(b.Activated,function()if busy then log('Hedefi değiştirmek için devam eden işlem bitsin.');return end;uploadOwner={mode=row.mode,id=row.id};plugin:SetSetting('HexforgeOwner',uploadOwner);updateOwnerLabel();ownerPanel.Visible=false;log('Hedef seçildi. Grup upload yetkisini Roblox kontrol eder; kişisele geçiş yapılmaz.')end)end
 ownerPanel.CanvasSize=UDim2.fromOffset(0,#rows*35);ownerPanel.Visible=true
end)end)
local function slider(y,title,min,max,initial,change)
 text(settingsPage,title,UDim2.fromOffset(0,y-3),UDim2.fromOffset(200,25),C.muted)
 local track=make('Frame',settingsPage,{Position=UDim2.fromOffset(230,y+7),Size=UDim2.fromOffset(330,6),BackgroundColor3=C.card,Active=true});round(track)
 local fill=make('Frame',track,{Size=UDim2.fromScale(0,1),BackgroundColor3=C.accent});round(fill)
 local knob=make('TextButton',track,{Size=UDim2.fromOffset(16,16),Position=UDim2.fromScale(0,.5),AnchorPoint=Vector2.new(.5,.5),Text='',BackgroundColor3=C.text,AutoButtonColor=false});round(knob,8)
 local value=text(settingsPage,'',UDim2.fromOffset(585,y-3),UDim2.fromOffset(65,26),C.accent);local dragInput
 local function set(n)n=math.clamp(n,min,max);local p=(n-min)/(max-min);fill.Size=UDim2.fromScale(p,1);knob.Position=UDim2.fromScale(p,.5);value.Text=string.format('%.0f%%',n*100);change(n)end
 local function move(x)set(min+math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)*(max-min))end
 local function begin(input)if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragInput=input;move(input.Position.X)end end
 bind(track.InputBegan,begin);bind(knob.InputBegan,begin);bind(UIS.InputChanged,function(input)if dragInput and(input==dragInput or input.UserInputType==Enum.UserInputType.MouseMovement)then move(input.Position.X)end end);bind(UIS.InputEnded,function(input)if input==dragInput or input.UserInputType==Enum.UserInputType.MouseButton1 then dragInput=nil end end);set(initial)
end
slider(244,'Önizleme ölçeği',.5,1.5,1,function(v)previewPreferences['HFZoom']=v;if previewGui then previewGui:SetAttribute('HFZoom',v)end end)
slider(282,'Geçiş hızı',.5,2,1,function(v)previewPreferences['HFSpeed']=v;if previewGui then previewGui:SetAttribute('HFSpeed',v)end end)
slider(320,'Parçacık yoğunluğu',0,1,1,function(v)previewPreferences['HFFxIntensity']=v;if previewGui then previewGui:SetAttribute('HFFxIntensity',v)end end)
local layerSearch=input(inspectPage,'Katman ara…',0,0,240,35)
local layerList=make('ScrollingFrame',inspectPage,{Position=UDim2.fromOffset(0,49),Size=UDim2.fromOffset(240,395),BackgroundColor3=C.card,ScrollBarThickness=4,CanvasSize=UDim2.new(),ClipsDescendants=true})
local reportScroll=make('ScrollingFrame',inspectPage,{Position=UDim2.fromOffset(257,49),Size=UDim2.fromOffset(393,395),BackgroundColor3=C.card,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=4,ClipsDescendants=true})
local reportBox=input(reportScroll,'',9,9,367,0);reportBox.AutomaticSize=Enum.AutomaticSize.Y;reportBox.MultiLine=true;reportBox.TextEditable=false;reportBox.TextWrapped=true;reportBox.TextSize=12;reportBox.TextXAlignment=Enum.TextXAlignment.Left;reportBox.TextYAlignment=Enum.TextYAlignment.Top
local function selectLayer(row)
 if selectedLayerOutline then selectedLayerOutline:Destroy();selectedLayerOutline=nil end
 local selected=previewGui and previewGui:FindFirstChild('Viewport'):FindFirstChild('Window'):FindFirstChild(row.name,true)
 if selected and selected:IsA('GuiObject')then selectedLayerOutline=CheckStyle.stroke(selected,Color3.fromRGB(255,208,0),2);selectedLayerOutline.Name='HF_InspectorHighlight'end
 reportBox.Text='SEÇİLİ KATMAN\n'..row.name..' / '..row.class..'\nAsset: '..tostring(row.asset or'—')..'\nMotion: '..tostring(row.motion or'—')..'\nAction: '..tostring(row.action or'—')..'\nStatik boyut: '..(row.measurable and(math.floor(row.width)..' × '..math.floor(row.height))or'— (GuiObject değil)')..'\n\nSalt okunur inceleme; paketi değiştirmez. Seçili öğe Paket sayfasında sarı çerçevelenir.\n\n'..currentReport.text
end
refreshInspection=function()
 for _,o in ipairs(layerList:GetChildren())do o:Destroy()end
 if not pack then reportBox.Text='Önce ZIP aç. Katmanlar ve statik kontroller burada görünür.';return end
 currentReport=Inspector.scan(pack.data);reportBox.Text=currentReport.text;local count=0;local q=layerSearch.Text:lower()
 for _,row in ipairs(currentReport.nodes)do
  if q==''or row.name:lower():find(q,1,true)then
   local b=make('TextButton',layerList,{Position=UDim2.fromOffset(5,count*33),Size=UDim2.fromOffset(225,30),BackgroundColor3=C.bg,Text=string.rep(' ',math.min(row.depth,4))..row.name,TextSize=11,TextColor3=C.text,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false});bind(b.Activated,function()selectLayer(row)end);count+=1
  end
 end;layerList.CanvasSize=UDim2.fromOffset(0,count*33)
end
button(inspectPage,'TEKRAR KONTROL',257,0,208,35,function()refreshInspection();log('Statik kontrol yenilendi; native doğrulama değildir.')end)
button(inspectPage,'ÖNİZLEMEYE DÖN',480,0,170,35,function()selectPage('Package')end)
bind(layerSearch:GetPropertyChangedSignal('Text'),refreshInspection)
refreshInspection()
selectPage('Package');show(false)
log('Hazır • Check-UI 1.1 • ZIP seç; kendi arayüzü API anahtarı gerektirmez.')
pcall(refreshLibrary)
task.spawn(function()local ok=pcall(Bridge.resume);if ok and not dead then operation(publishSkin)end end)
bind(plugin.Unloading,function()
 dead=true;canceled=true;for _,c in ipairs(connections)do c:Disconnect()end;disposePreview();host:Destroy()
end)
