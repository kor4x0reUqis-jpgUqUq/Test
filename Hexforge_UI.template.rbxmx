local Engine=(function()
local M={}
local HS=game:GetService('HttpService');local AS=game:GetService('AssetService');local Studio=game:GetService('StudioService')
function M.owner(mode,id)
 if mode=='Grup'then local n=tonumber(id);assert(n and n&gt;0 and n%1==0,'Geçerli grup ID gerekli');return {id=n,group=true,label='Grup #'..n}end
 if mode=='Hesabım'then local n=Studio:GetUserId();assert(n&gt;0,'Studio hesabında oturum aç');return{id=n,group=false,label='Hesabım #'..n}end
 if game.CreatorId&gt;0 then return{id=game.CreatorId,group=game.CreatorType==Enum.CreatorType.Group,label=(game.CreatorType==Enum.CreatorType.Group and 'Oyun grubu #'or'Oyun sahibi #')..game.CreatorId}end
 local n=Studio:GetUserId();assert(n&gt;0,'Studio hesabında oturum aç');return{id=n,group=false,label='Yayımlanmamış oyun → hesabım #'..n}
end
function M.load(raw)
 local zip=Binary.zip(raw);local d=HS:JSONDecode(zip:read('manifest.json'));local nodes=Schema.validate(d,zip)
 -- Parse/verify PNG now; verify RGBA once in preview or upload preflight before ANY cloud mutation.
 for _,a in ipairs(d.assets)do zip:read(a.png)end -- RGBA verified once during native preview, or before upload below.
 for _,c in ipairs(d.scripts or{})do local code=zip:read(c.path);assert(not code:find('%z'),'Kod içinde NUL var')end
 return{raw=raw,data=d,zip=zip,nodes=nodes,fingerprint=tostring(Binary.crc(raw))..':'..#raw}
end
local function decode(key,v,class)
 local e=Schema.enums[key];if e then return Enum[key=='AutomaticCanvasSize'and'AutomaticSize'or key][v]end
 local t=Schema.props[key]
 if t=='color'then local c=Color3.fromRGB(v[1],v[2],v[3]);return class=='UIGradient'and ColorSequence.new(c,c)or c end
 if t=='u2'then return UDim2.new(v[1],v[2],v[3],v[4])end
 if t=='u1'then return UDim.new(v[1],v[2])end
 if t=='v2'then return Vector2.new(v[1],v[2])end
 if t=='rect'then return Rect.new(v[1],v[2],v[3],v[4])end
 if key=='Transparency'and class=='UIGradient'then return NumberSequence.new(v)end
 return v
end
local function object(class,parent,name,props)
 local x=Instance.new(class);x.Name=name;if x:IsA('GuiObject')then x.BorderSizePixel=0 end
 for k,v in pairs(props or{})do x[k]=v end
 x.Parent=parent;return x
end
function M.build(pack,ids,parent,preview)
 local d=pack.data;local gui=Instance.new(preview and'Frame'or'ScreenGui');gui.Name='UIP_'..d.id
 local ok,err=xpcall(function()
 if preview then gui.Size=UDim2.fromScale(1,1);gui.BackgroundTransparency=1;gui.BorderSizePixel=0
 else gui.Enabled=false;gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.DisplayOrder=20 end
 gui:SetAttribute('HFBehavior',HS:JSONEncode(d.behavior or{}));gui:SetAttribute('NativeAcceptance','NOT_RUN_BY_AUTHOR');gui:SetAttribute('UIPackage',d.id);gui:SetAttribute('DesignWidth',d.designSize[1]);gui:SetAttribute('DesignHeight',d.designSize[2]);gui:SetAttribute('UIInstaller','Hexforge UI 1.1')
 local viewport=object('Frame',gui,'Viewport',{Size=UDim2.fromScale(1,1),BackgroundTransparency=1})
 object('Frame',viewport,'Backdrop',{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(5,9,20),BackgroundTransparency=1,BorderSizePixel=0})
 local window=object('CanvasGroup',viewport,'Window',{Size=UDim2.fromOffset(d.designSize[1],d.designSize[2]),Position=UDim2.fromScale(.5,.5),AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,GroupTransparency=0,ZIndex=2})
 object('UIScale',window,'ResponsiveScale',{Scale=1})
 local function visit(n,p)
  local x=Instance.new(n.class);x.Name=n.name;x.Parent=p
  for key,v in pairs(n.props or{})do local applied,why=pcall(function()x[key]=decode(key,v,n.class)end);assert(applied,n.name..'.'..key..': '..tostring(why))end
  if x:IsA('GuiObject')then if not(n.props or{}).BorderSizePixel then x.BorderSizePixel=0 end end
  if n.gradient then
   local g=n.gradient
   if g.colors then local stops={};for _,v in ipairs(g.colors)do table.insert(stops,ColorSequenceKeypoint.new(v[1],Color3.fromRGB(v[2],v[3],v[4])))end;x.Color=ColorSequence.new(stops)end
   if g.transparency then local stops={};for _,v in ipairs(g.transparency)do table.insert(stops,NumberSequenceKeypoint.new(v[1],v[2]))end;x.Transparency=NumberSequence.new(stops)end
   if g.rotation then x.Rotation=g.rotation end
  end
  if n.imageId then x.Image='rbxassetid://'..n.imageId end
  if n.asset then local ref=assert(ids[n.asset],'Eksik ID: '..n.asset);if typeof(ref)=='Content'then x.ImageContent=ref else x.Image=ref end end
  if n.action then x:SetAttribute('UIPAction',n.action)end;if n.motion then x:SetAttribute('UIPMotion',n.motion)end
  for _,c in ipairs(n.children or{})do visit(c,x)end;return x
 end
 local root=visit(d.tree,window);root.Size=UDim2.fromScale(1,1);root.Position=UDim2.fromOffset(0,0);root.AnchorPoint=Vector2.zero
 local reopen=object('TextButton',viewport,'Reopen',{Size=UDim2.fromOffset(180,44),Position=UDim2.new(.5,0,1,-18),AnchorPoint=Vector2.new(.5,1),BackgroundColor3=Color3.fromRGB(36,183,170),Text='MAĞAZAYI AÇ',Font=Enum.Font.GothamBold,TextSize=14,TextColor3=Color3.new(1,1,1),Visible=false,ZIndex=30,AutoButtonColor=false});object('UICorner',reopen,'Round',{CornerRadius=UDim.new(0,12)})
 if d.behavior and d.behavior.openAsset then
  reopen.Text='';reopen.BackgroundColor3=Color3.fromRGB(62,15,90);local img=object('ImageLabel',reopen,'OpenArtwork',{Size=UDim2.fromScale(.8,.7),Position=UDim2.fromScale(.1,.15),BackgroundTransparency=1,ScaleType=Enum.ScaleType.Fit});local ref=ids[d.behavior.openAsset];if typeof(ref)=='Content'then img.ImageContent=ref else img.Image=ref end
 end
 local toast=object('TextLabel',viewport,'Toast',{Size=UDim2.new(.9,0,0,50),Position=UDim2.new(.5,0,1,60),AnchorPoint=Vector2.new(.5,1),BackgroundColor3=Color3.fromRGB(23,37,55),Text='',TextSize=13,TextWrapped=true,Font=Enum.Font.Gotham,TextColor3=Color3.new(1,1,1),Visible=false,ZIndex=40});object('UICorner',toast,'Round',{CornerRadius=UDim.new(0,12)})
 if not preview then local s=Instance.new('LocalScript');s.Name='UI_Motion';s.Source=RuntimeSource;s.Parent=gui end
 gui.Parent=parent
 end,debug.traceback)
 if not ok then gui:Destroy();error(err,0)end
 return gui
end
function M.upload(pack,owner,pluginObject,manual,log,cancel,onProgress)
 -- No upload until EVERY byte is verified, including when preview was skipped/failed.
 if pack.zip.verified then for _,a in ipairs(pack.data.assets)do
  for _,path in ipairs({a.png,a.rgba})do if not pack.zip.verified[path]then pack.zip:read(path)end end
 end end
 local ids={};local cache=pluginObject:GetSetting('UIPAssetCacheV1')or{};if type(cache)~='table'then cache={}end
 local queue={};local completed=0
 for _,a in ipairs(pack.data.assets)do
  assert(not cancel(),'İşlem iptal edildi; tamamlanan asset yüklemeleri Roblox üzerinde kalır')
  local entry=pack.zip.entries[a.rgba];local key=table.concat({owner.group and'g'or'u',owner.id,pack.data.id,a.key,a.width,a.height,entry.crc},':')
  local cached=manual[a.key]or cache[key]
  if cached then local n=tonumber(tostring(cached):match('(%d+)$'));assert(n and n&gt;0 and n%1==0,'Geçersiz ID: '..a.key);ids[a.key]='rbxassetid://'..string.format('%.0f',n);completed+=1;log('Önbellekten: '..a.key)
  else table.insert(queue,{asset=a,key=key})end
 end
 local cursor=0;local running=0;local firstError
 local function worker()
  while not firstError and not cancel()do
   cursor+=1;local row=queue[cursor];if not row then break end
   local a=row.asset;log('Yükleniyor: '..a.key..' → '..owner.label)
   local ok,id=pcall(Bridge.upload,pack,a,owner,function()return cancel()or firstError~=nil end,log)
   if not ok then firstError=firstError or tostring(id);break end
   local n=tonumber(id);if not n or n&lt;=0 then firstError='Geçersiz gerçek assetId';break end
   ids[a.key]='rbxassetid://'..string.format('%.0f',n);cache[row.key]=n;completed+=1
   local saved=pcall(function()pluginObject:SetSetting('UIPAssetCacheV1',cache)end)
   log('Yüklendi: '..a.key..' → '..tostring(id));if not saved then log('Cache yazılamadı; gerçek ID: '..tostring(id))end
   if onProgress then onProgress(completed,#pack.data.assets,a.key)end
  end
  running-=1
 end
 if task and task.spawn and #queue&gt;1 then
  running=math.min(2,#queue);for _=1,running do task.spawn(worker)end
  while running&gt;0 do task.wait()end
 elseif #queue&gt;0 then running=1;worker()end
 if firstError then error(firstError,0)end
 assert(not cancel(),'İptal edildi; başlamış cloud işleri köprüde tamamlanabilir')
 return ids
end
-- Package scripts are installed only after explicit per-package approval in Main.
local function codeObject(pack,c,parent)
 local x=Instance.new(c.kind);x.Name=c.name;x.Parent=parent;x.Source=pack.zip:read(c.path);return x
end
function M.controllerSource(pack)
 return "local ctx={gui=script.Parent,preview=false,shared=game:GetService('ReplicatedStorage'):WaitForChild('UIP_Shared_"..pack.data.id.."')}\nlocal module=require(script.Parent:WaitForChild('"..pack.data.controller.."'))\nassert(type(module)=='table'and type(module.mount)=='function','Controller.mount gerekli')\nmodule.mount(ctx)"
end
function M.preview(pack,ids,parent,approved)
 local gui=M.build(pack,ids,parent,true)
 local ok,err=xpcall(function()
  Motion.mount(gui,ids)
  if approved and pack.data.controller then
   for _,c in ipairs(pack.data.scripts or{})do if c.target=='UI'and c.kind=='ModuleScript'then codeObject(pack,c,gui)end end
   local mod=require(gui:FindFirstChild(pack.data.controller));assert(type(mod)=='table'and type(mod.mount)=='function','Controller.mount gerekli');mod.mount({gui=gui,preview=true,shared=nil})
  end
 end,debug.traceback)
 if not ok then gui:Destroy();error(err,0)end
 return gui
end
function M.stage(pack,ids,owner,approved)
 assert(#(pack.data.scripts or{})==0 or approved,'Paket kodu onaylanmadı')
 local out={};local function add(x,svc)out[#out+1]={object=x,parent=game:GetService(svc)};return x end
 local ok,err=xpcall(function()
  local gui=add(M.build(pack,ids,nil,false),'StarterGui')
  local shared=Instance.new('Folder');shared.Name='UIP_Shared_'..pack.data.id;shared:SetAttribute('UIPackage',pack.data.id);add(shared,'ReplicatedStorage')
  local server=Instance.new('Folder');server.Name='UIP_Server_'..pack.data.id;server:SetAttribute('UIPackage',pack.data.id);add(server,'ServerScriptService')
  local client=Instance.new('Folder');client.Name='UIP_Client_'..pack.data.id;client:SetAttribute('UIPackage',pack.data.id);out[#out+1]={object=client,parent=game:GetService('StarterPlayer'):WaitForChild('StarterPlayerScripts')}
  for _,row in ipairs(out)do row.object:SetAttribute('AssetOwnerId',owner.id);row.object:SetAttribute('AssetOwnerType',owner.group and'Group'or'User')end
  local map=Instance.new('StringValue');map.Name='AssetMap';map.Value=HS:JSONEncode(ids);map.Parent=shared
  local same=map:Clone();same.Parent=gui
  local templates=Instance.new('Folder');templates.Name='VFX';templates.Parent=shared
  for _,f in ipairs(pack.data.vfx or{})do
   local model=Instance.new('Model');model.Name=f.name;model.Parent=templates
   local p=Instance.new('Part');p.Name='Origin';p.Size=Vector3.one;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Transparency=1;p.Parent=model;model.PrimaryPart=p
   local a=Instance.new('Attachment');a.Name='FX';a.Parent=p
   local e=Instance.new('ParticleEmitter');e.Name=f.name;e.Enabled=false;e.Texture=ids[f.texture];e.Rate=f.rate;e.Lifetime=NumberRange.new(f.lifetime[1],f.lifetime[2]);e.Speed=NumberRange.new(f.speed[1],f.speed[2]);e.Size=NumberSequence.new(f.size[1],f.size[2]);e.Color=ColorSequence.new(Color3.fromRGB(f.color[1],f.color[2],f.color[3]));e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(.7,.2),NumberSequenceKeypoint.new(1,1)});e.SpreadAngle=Vector2.new(45,45);e.LightEmission=.7;e.Drag=1;e.Parent=a
  end
  for _,c in ipairs(pack.data.scripts or{})do codeObject(pack,c,c.target=='UI'and gui or(c.target=='Shared'and shared or(c.target=='Server'and server or client)))end
  if pack.data.controller then local x=Instance.new('LocalScript');x.Name='Package_Start';x.Source=M.controllerSource(pack);x.Parent=gui end
 end,debug.traceback)
 if not ok then for _,row in ipairs(out)do row.object:Destroy()end;error(err,0)end
 return out
end
function M.canInstall(pack,replace)
 local id=pack.data.id
 local slots={{game:GetService('StarterGui'),'UIP_'..id},{game:GetService('ReplicatedStorage'),'UIP_Shared_'..id},{game:GetService('ServerScriptService'),'UIP_Server_'..id},{game:GetService('StarterPlayer'):WaitForChild('StarterPlayerScripts'),'UIP_Client_'..id}}
 for _,slot in ipairs(slots)do local old=slot[1]:FindFirstChild(slot[2]);if old then assert(replace,'Paket kurulu; Gelişmiş &gt; güncelle seçeneğini aç');assert(old:GetAttribute('UIPackage')==id,'Farklı içerik korunuyor: '..old.Name)end end
end
function M.commit(rows,replace,packId)
 local existing={}
 for _,row in ipairs(rows)do
  local old=row.parent:FindFirstChild(row.object.Name)
  if old then assert(replace,'Aynı paket mevcut: Güncelle seçeneğini aç');assert(old:GetAttribute('UIPackage')==packId,'Aynı adlı farklı içerik korunuyor: '..old.Name);table.insert(existing,{object=old,parent=row.parent})end
 end
 local backup=Instance.new('Folder');backup.Name='UIP_Pro_Backup_'..os.time();backup.Parent=game:GetService('ServerStorage')
 local ok,err=xpcall(function()
  for _,row in ipairs(existing)do row.object.Parent=backup end
  for _,row in ipairs(rows)do row.object.Parent=row.parent end
 end,debug.traceback)
 if not ok then
  for _,row in ipairs(rows)do row.object:Destroy()end
  for _,row in ipairs(existing)do row.object.Parent=row.parent end
  backup:Destroy();error(err,0)
 end
 return{created=rows,previous=existing,backup=backup}
end
function M.undo(record)
 for _,r in ipairs(record.created)do assert(r.object.Parent==r.parent,'Kurulan içerik taşındı; otomatik geri alma durdu')end
 for _,r in ipairs(record.previous)do assert(r.object.Parent==record.backup,'Yedek taşındı; otomatik geri alma durdu')end
 for _,r in ipairs(record.created)do r.object:Destroy()end
 for _,r in ipairs(record.previous)do r.object.Parent=r.parent end
 if #record.backup:GetChildren()==0 then record.backup:Destroy()end
end
return M

end)()
